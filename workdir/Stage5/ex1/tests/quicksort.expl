decl
    int arr[20], n;
    int partition(int lo, int hi), quicksort(int lo, int hi);
enddecl

int partition(int lo, int hi) {
    decl
        int pivot, i, j, t;
    enddecl
    begin
        pivot = arr[hi];
        i = lo - 1;
        j = lo;
        while (j < hi) do
            if (arr[j] <= pivot) then
                i = i + 1;
                t = arr[i];
                arr[i] = arr[j];
                arr[j] = t;
            endif;
            j = j + 1;
        endwhile;
        t = arr[i + 1];
        arr[i + 1] = arr[hi];
        arr[hi] = t;
        return i + 1;
    end
}

int quicksort(int lo, int hi) {
    decl
        int p, x;
    enddecl
    begin
        if (lo < hi) then
            p = partition(lo, hi);
            x = quicksort(lo, p - 1);
            x = quicksort(p + 1, hi);
        endif;
        return 0;
    end
}

int main() {
    decl
        int i, x;
    enddecl
    begin
        read(n);
        i = 0;
        while (i < n) do
            read(arr[i]);
            i = i + 1;
        endwhile;
        x = quicksort(0, n - 1);
        i = 0;
        while (i < n) do
            write(arr[i]);
            i = i + 1;
        endwhile;
        return 0;
    end
}
